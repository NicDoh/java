<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.geometry.Insets?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.MainMenuController">
    <ImageView fx:id="backgroundImage" fitWidth="800" fitHeight="600" preserveRatio="false">
        <image>
            <Image url="@bg1.png"/>
        </image>
    </ImageView>
    <VBox alignment="CENTER" spacing="10">
        <Button text="Start game" onAction="#startGame"/>
        <Button text="Chat" onAction="#openChat"/>
        <Button text="Settings" onAction="#openSettings"/>
        <Button text="Exit" onAction="#exitGame"/>
    </VBox>
</StackPane>