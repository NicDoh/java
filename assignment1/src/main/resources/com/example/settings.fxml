<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.SettingsController">
    <ImageView fx:id="backgroundImage" fitWidth="800" fitHeight="600" preserveRatio="false">
        <image>
            <Image url="@bg1.png"/>
        </image>
    </ImageView>
    <VBox alignment="CENTER" spacing="10">
        <Button text="Baggrund 1" onAction="#selectBg1"/>
        <Button text="Baggrund 2" onAction="#selectBg2"/>
        <Button text="Baggrund 3" onAction="#selectBg3"/>
        <Button text="Tilbage" onAction="#goBack"/>
    </VBox>
</StackPane>