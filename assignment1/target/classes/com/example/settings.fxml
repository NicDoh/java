<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.SettingsController">
    <ImageView fx:id="backgroundImage" fitWidth="800" fitHeight="600" preserveRatio="false">
        <image>
            <Image url="@bg1.png"/>
        </image>
    </ImageView>
    <VBox StackPane.alignment="CENTER" spacing="10" alignment="CENTER">
        <MenuButton text="Change background">
            <items>
                <MenuItem text="Background 1" onAction="#selectBg1"/>
                <MenuItem text="Background 2" onAction="#selectBg2"/>
                <MenuItem text="Background 3" onAction="#selectBg3"/>
            </items>
        </MenuButton>
        <MenuButton text="Choose arena">
            <items>
                <MenuItem text="Arena 1" onAction="#selectArena1"/>
                <MenuItem text="Arena 2" onAction="#selectArena2"/>
                <MenuItem text="Arena 3" onAction="#selectArena3"/>
            </items>
        </MenuButton>
        <Button text="Main menu" onAction="#goBack"/>
    </VBox>
</StackPane>
