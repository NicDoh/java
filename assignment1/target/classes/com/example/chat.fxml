<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.ChatController">
    <ImageView fx:id="backgroundImage" fitWidth="800" fitHeight="600" preserveRatio="false">
        <image>
            <Image url="@bg1.png"/>
        </image>
    </ImageView>
    <VBox spacing="10" style="-fx-padding: 20;">
        <HBox spacing="10" VBox.vgrow="ALWAYS">
            <ListView fx:id="userList" prefWidth="150"/>
            <TextArea fx:id="messageArea" editable="false" HBox.hgrow="ALWAYS"/>
        </HBox>
        <HBox spacing="10">
            <TextField fx:id="messageInput" promptText="Enter message here..." HBox.hgrow="ALWAYS"/>
            <VBox spacing="5">
                <Button text="Send" onAction="#sendMessage"/>
                <Button text="Main menu" onAction="#goBack"/>
            </VBox>
        </HBox>
    </VBox>
</StackPane>